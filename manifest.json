{
  "manifest_version": 3,
  "name": "Personal VPN Media Detector",
  "version": "0.2.43",
  "description": "Personal-use media downloader and ad blocker with a local authenticated bridge.",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "declarativeNetRequest", "nativeMessaging", "offscreen", "scripting", "storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "wherewindsmeet_redirect_block",
        "enabled": true,
        "path": "redirect-block-rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["level5-page-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["adblock/adblock-rules.global.js", "adblock/adblock-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Personal VPN media candidates",
    "default_popup": "popup.html"
  }
}
