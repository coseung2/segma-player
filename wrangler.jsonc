{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "compatibility_date": "2026-08-12",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "USDT_TRC20_ADDRESS": "TGwSFr1JQhMz9bn2RfqQs4zJfRwv7rcWK5",
    "MODAL_ASR_URL": "https://mallagaenge--aura-japanese-asr-web.modal.run"
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "6cf06b4390d149788de9ee8d64b50efb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMPANION_BUCKET",
      "bucket_name": "aura-media-companion"
    }
  ]
}
